APP_NAME=智药护航 API
ENVIRONMENT=production

# PostgreSQL（推荐 Neon 免费层：https://neon.tech）
# 形如：postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# 生产环境必须替换为长随机串（至少 32 字节）
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440

# CORS：填前端正式域名，多个用英文逗号分隔
# 部署后示例：CORS_ORIGINS=https://zhiyouyao.vercel.app
CORS_ORIGINS=http://localhost:5173

# 扣子（Coze）智能体接入：留空走兜底逻辑，不影响系统使用
COZE_TOKEN=
COZE_BOT_ID=

# 智谱 GLM 视觉模型：留空走模拟数据，不影响系统使用
ZHIPU_API_KEY=